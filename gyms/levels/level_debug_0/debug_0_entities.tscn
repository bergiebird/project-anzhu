[node name="Signs" type="Node2D" parent="Props" unique_id=1145761115]

[node name="Bear; Shots" parent="Props/Signs" unique_id=10886156 instance=ExtResource("4_5yen0")]
position = Vector2(1248, 676)
sign_contents = "Bears take many shots to down, 10w shots to be exact. Muskets are powerful, yet they are still weak against a creature with thick fur.

Consider giving yourself enough time to reload your weapon."
visual_description = "A sign that you may need to hike for to get its information."

[node name="Bear; Reload" parent="Props/Signs" unique_id=1084712849 instance=ExtResource("4_5yen0")]
position = Vector2(1256, 400)
sign_contents = "A good hunter reloads his weapon when no one is in sight."
visual_description = "A sign that you may need to hike for to get its information.q"

[node name="Bear; Grudges" parent="Props/Signs" unique_id=1616008228 instance=ExtResource("4_5yen0")]
position = Vector2(1476, 572)
sign_contents = "
Bears hold grudges. 

They will always be hunting you if you piss them off. Just, ya know, dont make loud noises around them."
visual_description = "A sign detailing a warning"

[node name="Bear; Warning" parent="Props/Signs" unique_id=1099587537 instance=ExtResource("4_5yen0")]
position = Vector2(271, 554)
sign_contents = "Use your gun {E} if you have to! "
visual_description = "You spot claw marks up & down the sign"

[node name="Campfire; Controls" parent="Props/Signs" unique_id=1378242442 instance=ExtResource("4_5yen0")]
position = Vector2(1392, 720)
sign_contents = "Use {Space} to turn the Campfire on/off."
visual_description = "Slightly singed"

[node name="Campfire; Heal" parent="Props/Signs" unique_id=1616089168 instance=ExtResource("4_5yen0")]
position = Vector2(256, -242)
sign_contents = "You found a corner!

Campfires heal damage over time."
visual_description = "A lonely sign."

[node name="Cave; Congrats" parent="Props/Signs" unique_id=16670251 instance=ExtResource("4_5yen0")]
position = Vector2(1276, 76)
sign_contents = "Congrats on successful jumps!"
visual_description = "A dusty old sign in a deep pit."

[node name="Cave; Greeting" parent="Props/Signs" unique_id=1180659133 instance=ExtResource("4_5yen0")]
position = Vector2(209, 28)
sign_contents = "Welcome to the Cave!"
visual_description = "This sign looks to contain some moss on it."

[node name="Controls; Jump Down" parent="Props/Signs" unique_id=1276505403 instance=ExtResource("4_5yen0")]
position = Vector2(304, 678)
sign_contents = "You can jump down cliffs but you can't jump up cliffs."
visual_description = "A helpul sign that seems to be instructing on jumping down."

[node name="Controls; Jump Same" parent="Props/Signs" unique_id=1912365534 instance=ExtResource("4_5yen0")]
position = Vector2(209, 720)
sign_contents = "Fog is your friend when figuring out if you can jump somewhere. "
visual_description = "A helpul sign that seems to be instructing on what can be jumped over."

[node name="Controls; Jump Same2" parent="Props/Signs" unique_id=1733445788 instance=ExtResource("4_5yen0")]
position = Vector2(1317, 678)
sign_contents = "Welcome! You're on the Anzhu Islands in the 18th century. You were shipwrecked and now you're confined to this small zone so you can learn jumping. 

Press {U} to jump. You can jump down hills. "
visual_description = "A helpul sign that seems to be instructing on what can be jumped over."

[node name="Drifwood; Info" parent="Props/Signs" unique_id=1130125087 instance=ExtResource("4_5yen0")]
position = Vector2(1395, 820)
sign_contents = "You can pickup Driftwood {Space}."
visual_description = "Barnacles seem to be accumulating on the post"

[node name="Walrus; Not Ready" parent="Props/Signs" unique_id=1888021555 instance=ExtResource("4_5yen0")]
position = Vector2(955, 727)
sign_contents = "This is the Walrus, he cant do to much at this time. If you're looking for bears, find their tracks in the middle of the map!"
visual_description = "A lonely sign"

[node name="Fun Fact; Treeless" parent="Props/Signs" unique_id=1406276788 instance=ExtResource("4_5yen0")]
position = Vector2(240, -3)
sign_contents = "Fun fact, these islands contain no trees but their shores are littered with driftwood."
visual_description = "Seem's pretty clean"

[node name="Teleport;" parent="Props/Signs" unique_id=1815451304 instance=ExtResource("4_5yen0")]
position = Vector2(153, 278)
sign_contents = "You CAN jump into that whirlpool. Does it take you anywhere cool? "
visual_description = "A sign on a far off island."

[node name="Teleport;2" parent="Props/Signs" unique_id=2142677656 instance=ExtResource("4_5yen0")]
position = Vector2(1468, -244)
sign_contents = "Gettint lost? There isn't much of anything up here."
visual_description = "Another lonely sign"

[node name="Doors" type="Node2D" parent="Props" unique_id=490925150]
editor_description = "Container for all doors.

