[node name="Drifwood; Info2" parent="NODE2D/Entities/Props" instance=ExtResource("14_b8ymc")]
position = Vector2(947, 784)
sign_contents = "This is my Walrus, he's not ready to do much. If you're looking for bears, follow their tracks!"
visual_description = "Barnacles seem to be accumulating on the post"

[node name="Controls; Campfire" parent="NODE2D/Entities/Props" instance=ExtResource("14_b8ymc")]
position = Vector2(1325, 733)
sign_contents = "Use {F} to turn the Campfire on/off.

Campfires will heal you if you get damaged!"
visual_description = ""

[node name="Controls; Jump Down" parent="NODE2D/Entities/Props" instance=ExtResource("14_b8ymc")]
position = Vector2(335, 686)
sign_contents = "You can jump down cliffs but you can't jump up cliffs.

Use U to jump down cliffs. If you crouch, then you did it right!"
visual_description = "A helpul sign that seems to be instructing on jumping down."

[node name="Controls; Jump Same" parent="NODE2D/Entities/Props" instance=ExtResource("14_b8ymc")]
position = Vector2(241, 727)
sign_contents = "You can jump over gaps like these.

Use U to jump over gaps."
visual_description = "A helpul sign that seems to be instructing on what can be jumped over."

[node name="Controls; Jump Same2" parent="NODE2D/Entities/Props" instance=ExtResource("14_b8ymc")]
position = Vector2(1317, 678)
sign_contents = "Welcome! You're on the Anzhu Islands in the 18th century. You were shipwrecked and now you're confined to this small zone so you can learn jumping. 

Press {U} to jump. You can jump down hills. "
visual_description = "A helpul sign that seems to be instructing on what can be jumped over."

[node name="Cave; Greeting" parent="NODE2D/Entities/Props" instance=ExtResource("14_b8ymc")]
position = Vector2(211, -3)
sign_contents = "Welcome to the Cave!"
visual_description = "This sign looks to contain some moss on it."

[node name="Cave; Congrats" parent="NODE2D/Entities/Props" instance=ExtResource("14_b8ymc")]
position = Vector2(1272, 76)
sign_contents = "Congrats on successful jumps!"
visual_description = "A dusty old sign in a deep pit."

[node name="Teleport Info; Island" parent="NODE2D/Entities/Props" instance=ExtResource("14_b8ymc")]
position = Vector2(152, 278)
sign_contents = "You CAN jump into that whirlpool. Does it take you anywhere cool? "
visual_description = "A sign on a far off island."

[node name="Bear Info; Grudges" parent="NODE2D/Entities/Props" instance=ExtResource("14_b8ymc")]
position = Vector2(1457, 570)
sign_contents = "
Bears hold grudgees. 

They will always be hunting you if you piss them off. Just, ya know, dont make loud noises around them."
visual_description = "A sign supporting the warnings the previous sign lays out."

[node name="Bear Info; Shots" parent="NODE2D/Entities/Props" instance=ExtResource("14_b8ymc")]
position = Vector2(748, 686)
sign_contents = "
Bears take many shots to down, 12 shots to be exact. Muskets are powerful, yet they are still weak against a creature with thick fur.

Consider giving yourself enough time to reload your weapon."
visual_description = "A sign that you may need to hike for to get its information."

