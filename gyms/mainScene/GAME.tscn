position = Vector2(747, 728)
sign_contents = "Fun fact, these islands contain no trees but their shores are littered with driftwood."
visual_description = "Barnacles seem to be accumulating on the post"

[node name="Drifwood; Info" parent="NODE2D/Entities/Props" instance=ExtResource("14_b8ymc")]
position = Vector2(1257, 788)
sign_contents = "You can pickup Driftwood {F}. But don't expect them to be useful at this stage. "
