; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="[HAGJ] - Arctic Exploration"
run/main_scene="res://scenes/game.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://warehouse/~examples/arctic-3.png"

[audio]

buses/default_bus_layout="res://resources/polar_bear/audio/default_bus_layout.tres"
general/default_playback_type.web=0

[autoload]

Signalton="*res://resources/_singletons/Signalton.gd"
Enumerton="*res://resources/_singletons/Enumerton.gd"
DayNighton="*res://resources/_singletons/DayNighton.gd"
Audioton="*res://resources/_singletons/Audioton.gd"

[debug]

gdscript/warnings/unused_variable=0
gdscript/warnings/unused_local_constant=0
gdscript/warnings/unused_private_class_variable=0
gdscript/warnings/unused_parameter=0
gdscript/warnings/unused_signal=0

[display]

window/size/viewport_width=2400
window/size/viewport_height=2400
window/size/mode=3
window/size/window_width_override=640
window/size/window_height_override=480
window/stretch/mode="viewport"

[file_customization]

folder_colors={
"res://resources/": "purple",
"res://scenes/": "purple",
"res://warehouse/": "gray"
}

